# Use relative URL in development to go through Vite proxy.
# In production Docker/nginx this also works through nginx /api proxy.
VITE_BACKEND_BASE_URL=/api/admin

# Optional: explicit backend target for Vite dev proxy.
VITE_BACKEND_PROXY_TARGET=http://localhost:4000

VITE_REFINE_DEVTOOLS=false
REFINE_NO_TELEMETRY=true
VITE_HOST=0.0.0.0
VITE_PORT=5174
