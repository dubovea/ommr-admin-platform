{
  "name": "@ommr/admin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn run -T dev:admin-backend",
    "build": "tsc",
    "start": "yarn run -T start:admin-backend",
    "seed": "yarn run -T seed",
    "seed:prod": "yarn run -T seed:prod",
    "db:reset": "yarn run -T db:reset",
    "db:generate": "yarn run -T db:generate",
    "db:generate:prod": "yarn run -T db:generate:prod",
    "db:migrate": "yarn run -T db:migrate",
    "db:migrate:prod": "yarn run -T db:migrate:prod",
    "db:push": "yarn run -T db:push",
    "db:push:prod": "yarn run -T db:push:prod",
    "db:studio": "yarn run -T db:studio",
    "db:studio:prod": "yarn run -T db:studio:prod",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/services/pydantic-schema-parser.service.test.ts"
  },
  "dependencies": {
    "@ommr/shared": "workspace:*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.4",
    "express": "^5.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
