{
  "name": "ommr-admin-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,admin -c blue,green \"yarn dev:api\" \"yarn dev:admin\"",
    "dev:admin": "yarn workspace @ommr/admin dev",
    "dev:api": "yarn workspace @ommr/api dev",
    "build": "yarn workspace @ommr/shared typecheck && yarn workspace @ommr/api build && yarn workspace @ommr/admin build",
    "build:admin": "yarn workspace @ommr/admin build",
    "build:api": "yarn workspace @ommr/api build",
    "typecheck": "yarn workspace @ommr/shared typecheck && yarn workspace @ommr/api typecheck && yarn workspace @ommr/admin typecheck",
    "db:generate": "yarn workspace @ommr/api db:generate",
    "db:migrate": "yarn workspace @ommr/api db:migrate",
    "db:push": "yarn workspace @ommr/api db:push",
    "db:studio": "yarn workspace @ommr/api db:studio",
    "seed": "yarn workspace @ommr/api seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "yarn@4.14.1"
}
