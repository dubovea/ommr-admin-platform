# Copy this file to .env.development or .env.production.

APP_ENV=development

# PostgreSQL connection parts.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ommr_admin
DB_USER=ommr
DB_PASSWORD=ommr_password
DB_SSL=false

# Backend listens only inside the Docker image.
HOST=127.0.0.1
PORT=4000

# Public host port is configured in docker run: -p 5174:80.

# Backend request body limit.
JSON_BODY_LIMIT=20mb

# Nginx request body limit.
NGINX_CLIENT_MAX_BODY_SIZE=20m

# Frontend should use same-origin API path.
# In development Vite proxies /api to backend.
# In Docker nginx proxies /api to backend.
VITE_BACKEND_PROXY_TARGET=http://localhost:4000
VITE_BACKEND_BASE_URL=/api/admin

# Optional frontend flags.
VITE_REFINE_DEVTOOLS=false
REFINE_NO_TELEMETRY=true
